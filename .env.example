# ================= AI PROVIDER =================
# Choose one: ollama | openai | anthropic | gemini
AI_PROVIDER=ollama

# --- Ollama (local machine, VPS, or remote server) ---
# Local:            http://localhost:11434
# Streamlit Cloud:  point this at your VPS Ollama URL (must be publicly reachable, HTTPS recommended)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ================= OPTIONAL TUNING =================
# Respect robots.txt when scraping full web pages (recommended: true)
RESPECT_ROBOTS=true
# Default HTTP timeout in seconds
REQUEST_TIMEOUT=10
# Cache TTL in hours for suggestion / page fetches
CACHE_TTL_HOURS=6
# Minimum seconds between requests to the same domain
RATE_LIMIT_SECONDS=0.9
# Max parallel fetch workers
MAX_WORKERS=6

# ── Search volume (optional — real monthly volumes) ─────────────────
# If neither is set, volumes are estimated from Trends + suggestion signals
# and clearly labeled "(est.)".
# Keywords Everywhere (https://keywordseverywhere.com — cheap credit packs):
KEYWORDS_EVERYWHERE_API_KEY=
# DataForSEO (https://dataforseo.com — Google Ads volume):
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
